#!/usr/bin/env python3
"""
Nitter 推文爬蟲伺服器 - 批量抓取多用戶推文
支援自動重試、進度追蹤、增量更新
"""

import requests
from bs4 import BeautifulSoup
import sqlite3
from datetime import datetime
import time
import re
import json
import logging
import random
from urllib.parse import urljoin
from pathlib import Path

# 設定日誌
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s [%(levelname)s] %(message)s',
    handlers=[
        logging.FileHandler('nitter_scraper.log', encoding='utf-8'),
        logging.StreamHandler()
    ]
)
logger = logging.getLogger(__name__)


class NitterServer:
    def __init__(self, config_path='users.json', db_path='mydb.db'):
        """
        初始化 Nitter 爬蟲伺服器
        
        Args:
            config_path: 用戶配置文件路徑
            db_path: SQLite 資料庫路徑
        """
        self.config_path = config_path
        self.db_path = db_path
        
        # 預設 Nitter 實例列表（優先順序排序）
        # 建議使用自建實例以確保穩定性
        self.default_instances = [
            'localhost:8080',  # 本地自建實例（預設）
            'nitter.poast.org',
            'nitter.privacydev.net',
            'nitter.net',
        ]
        
        self.nitter_instances = []
        self.current_instance = None
        self.headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
        }
        
        self.load_config()
        self.init_database()
    
    def load_config(self):
        """載入用戶配置"""
        try:
            with open(self.config_path, 'r', encoding='utf-8') as f:
                config = json.load(f)
                self.users = config.get('users', [])
                self.settings = config.get('settings', {})
                
                # 建立 username -> id 映射表
                self.username_to_id = {}
                for user in self.users:
                    username = user.get('username')
                    user_id = str(user.get('id', ''))
                    if username and user_id:
                        self.username_to_id[username] = user_id
                
                # 從配置文件讀取自定義 Nitter 實例
                custom_instances = self.settings.get('nitter_instances', [])
                if custom_instances:
                    self.nitter_instances = custom_instances
                    logger.info(f"✓ 使用自定義 Nitter 實例：{len(custom_instances)} 個")
                else:
                    self.nitter_instances = self.default_instances
                    logger.warning("⚠ 未配置自建實例，使用預設列表（公共實例可能不穩定）")
                
                logger.info(f"✓ 載入配置：{len(self.users)} 個用戶")
        except FileNotFoundError:
            logger.warning(f"配置文件不存在：{self.config_path}，將使用預設配置")
            self.users = []
            self.settings = {}
            self.username_to_id = {}
            self.nitter_instances = self.default_instances
        except Exception as e:
            logger.error(f"載入配置失敗：{e}")
            self.users = []
            self.settings = {}
            self.username_to_id = {}
            self.nitter_instances = self.default_instances
    
    def init_database(self):
        """初始化資料庫結構"""
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            
            # 推文表
            cursor.execute('''
                CREATE TABLE IF NOT EXISTS tweets (
                    tweet_id TEXT PRIMARY KEY,
                    text TEXT NOT NULL,
                    author_id TEXT NOT NULL,
                    type TEXT DEFAULT 'Tweet',
                    created_at TIMESTAMP,
                    hashtags TEXT,
                    urls TEXT,
                    media_type TEXT,
                    media_urls TEXT,
                    scraped_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                    UNIQUE(tweet_id)
                )
            ''')
            
            # 用戶表
            cursor.execute('''
                CREATE TABLE IF NOT EXISTS users (
                    username TEXT PRIMARY KEY,
                    display_name TEXT,
                    bio TEXT,
                    followers_count INTEGER,
                    following_count INTEGER,
                    tweet_count INTEGER,
                    last_scraped TIMESTAMP,
                    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
            ''')
            
            # 爬取記錄表
            cursor.execute('''
                CREATE TABLE IF NOT EXISTS scrape_logs (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    username TEXT NOT NULL,
                    tweets_found INTEGER DEFAULT 0,
                    tweets_new INTEGER DEFAULT 0,
                    tweets_updated INTEGER DEFAULT 0,
                    status TEXT DEFAULT 'running',
                    error_message TEXT,
                    started_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                    completed_at TIMESTAMP
                )
            ''')
            
            conn.commit()
            conn.close()
            logger.info("資料庫初始化完成")
            
        except Exception as e:
            logger.error(f"資料庫初始化失敗：{e}")
            raise
    
    def test_instance(self, instance):
        """測試 Nitter 實例是否可用"""
        try:
            # 判斷是否為本地實例（不使用 HTTPS）
            if instance.startswith('localhost') or instance.startswith('127.0.0.1'):
                url = f"http://{instance}"
            else:
                url = f"https://{instance}"
            
            response = requests.get(url, headers=self.headers, timeout=5)
            return response.status_code == 200
        except Exception as e:
            logger.debug(f"實例測試失敗 {instance}: {e}")
            return False
    
    def get_working_instance(self):
        """獲取可用的 Nitter 實例"""
    
    def test_instance(self, instance):
        """測試 Nitter 實例是否可用"""
        try:
            url = f"https://{instance}"
            response = requests.get(url, headers=self.headers, timeout=5)
            return response.status_code == 200
        except:
            return False
    
    def get_working_instance(self):
        """獲取可用的 Nitter 實例"""
        if self.current_instance and self.test_instance(self.current_instance):
            return self.current_instance
        
        for instance in self.nitter_instances:
            logger.info(f"測試 Nitter 實例: {instance}")
            if self.test_instance(instance):
                logger.info(f"✓ 使用實例: {instance}")
                self.current_instance = instance
                return instance
        
        raise Exception("❌ 沒有可用的 Nitter 實例")
    
    def scrape_user_tweets(self, username, max_tweets=None, max_pages=50):
        """
        爬取指定用戶的推文
        
        Args:
            username: Twitter 用戶名
            max_tweets: 最大推文數（None = 全部）
            max_pages: 最大頁數限制
        
        Returns:
            推文列表
        """
        instance = self.get_working_instance()
        tweets = []
        cursor = None
        page_count = 0
        retry_count = 0
        max_retries = 3
        
        # 計時器：每 15 分鐘休息
        start_time = time.time()
        work_duration = 15 * 60  # 15 分鐘（秒）
        rest_duration = 60  # 休息 1 分鐘
        
        logger.info(f"開始爬取 @{username} 的推文")
        
        while True:
            # 檢查是否達到限制
            if max_tweets and len(tweets) >= max_tweets:
                logger.info(f"已達到推文數量限制：{max_tweets}")
                break
            
            # 判斷是否為本地實例（本地實例使用 HTTP）
            if instance.startswith('localhost') or instance.startswith('127.0.0.1'):
                url = f"http://{instance}/{username}"
            else:
                url = f"https://{instance}/{username}"
            
            if page_count >= max_pages:
                logger.info(f"已達到頁數限制：{max_pages}")
                break
            
            # 檢查是否需要休息
            elapsed_time = time.time() - start_time
            if elapsed_time >= work_duration:
                logger.info(f"⏸ 已連續工作 15 分鐘，休息 {rest_duration} 秒...")
                time.sleep(rest_duration)
                start_time = time.time()
            
            # 構建 URL
            url = f"https://{instance}/{username}"
            if cursor:
                url += f"?cursor={cursor}"
            
            try:
                logger.info(f"爬取第 {page_count + 1} 頁...")
                response = requests.get(url, headers=self.headers, timeout=15)
                response.raise_for_status()
                soup = BeautifulSoup(response.content, 'html.parser')
                
                # 檢查是否為私人或不存在的帳號
                error_panel = soup.find('div', class_='error-panel')
                if error_panel:
                    error_msg = error_panel.get_text(strip=True)
                    logger.error(f"❌ 帳號錯誤：{error_msg}")
                    break
                
                # 找到推文項目
                timeline_items = soup.find_all('div', class_='timeline-item')
                
                if not timeline_items:
                    logger.info("未找到更多推文，爬取結束")
                    break
                
                page_tweets = 0
                for item in timeline_items:
                    if max_tweets and len(tweets) >= max_tweets:
                        break
                    
                    tweet_data = self.parse_tweet(item, username)
                    if tweet_data:
                        tweets.append(tweet_data)
                        page_tweets += 1
                
                logger.info(f"  本頁爬取 {page_tweets} 條推文，累計 {len(tweets)} 條")
                
                # 查找下一頁
                show_more = soup.find('div', class_='show-more')
                if show_more and show_more.find('a'):
                    cursor = show_more.find('a')['href'].split('cursor=')[-1]
                else:
                    break
                
                # 每次請求後隨機延遲 1-5 秒
                delay = random.uniform(1, 5)
                logger.debug(f"等待 {delay:.1f} 秒...")
                        cursor = href.split('cursor=')[-1]
                        page_count += 1
                        retry_count = 0  # 重置重試計數
                    else:
                        logger.info("無法找到下一頁游標")
                        break
                else:
                    logger.info("已到最後一頁")
                    break
                
                # 請求延遲
                delay = self.settings.get('request_delay', 2)
                time.sleep(delay)
                
            except requests.exceptions.RequestException as e:
                retry_count += 1
                logger.warning(f"請求失敗 ({retry_count}/{max_retries}): {e}")
                
                if retry_count >= max_retries:
                    logger.error(f"達到最大重試次數，停止爬取")
                    break
                
                # 嘗試切換實例
                try:
                    self.current_instance = None
                    instance = self.get_working_instance()
                    logger.info(f"切換到新實例：{instance}")
                except:
                    logger.error("無法切換到新實例")
                    break
                
                time.sleep(5)  # 重試前等待
                continue
            
            except Exception as e:
                logger.error(f"爬取錯誤：{e}")
                break
        
        logger.info(f"✓ @{username} 爬取完成，總共 {len(tweets)} 條推文")
        return tweets
    
    def parse_tweet(self, item, username):
        """解析單條推文"""
        try:
            tweet_data = {}
            
            # 推文內容
            content_div = item.find('div', class_='tweet-content')
            if content_div:
                tweet_data['text'] = content_div.get_text(strip=True)
            else:
                return None
            
            # 推文 ID
            tweet_link = item.find('a', class_='tweet-link')
            if tweet_link:
                href = tweet_link.get('href', '')
                match = re.search(r'/status/(\d+)', href)
                if match:
                    tweet_data['tweet_id'] = match.group(1)
                else:
                    # 如果沒有 ID，跳過這條推文
                    return None
            else:
                return None
            
            # 時間
            tweet_date = item.find('span', class_='tweet-date')
            if tweet_date:
                date_link = tweet_date.find('a')
                if date_link:
                    date_str = date_link.get('title', '')
                    tweet_data['created_at'] = self.parse_date(date_str)
            
            if not tweet_data.get('created_at'):
                tweet_data['created_at'] = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
            
            # Hashtags
            hashtags = [tag.get_text() for tag in content_div.find_all('a', href=re.compile(r'/search\?q=%23'))]
            tweet_data['hashtags'] = ','.join(hashtags)
            
            # URLs
            urls = []
            for link in content_div.find_all('a'):
                href = link.get('href', '')
                if href and not href.startswith('#') and not href.startswith('/'):
                    urls.append(href)
            tweet_data['urls'] = ','.join(urls)
            
            # 媒體
            attachments = item.find('div', class_='attachments')
            media_urls = []
            media_type = ''
            
            if attachments:
                # 圖片
                images = attachments.find_all('a', class_='still-image')
                if images:
                    media_type = 'photo'
                    for img in images:
                        img_url = img.get('href', '')
                        if img_url:
                            media_urls.append(img_url)
                
                # 影片
                video = attachments.find('video')
                if video:
                    media_type = 'video'
                    video_source = video.find('source')
                    if video_source:
                        media_urls.append(video_source.get('src', ''))
            
            tweet_data['media_type'] = media_type
            tweet_data['media_urls'] = ','.join(media_urls)
            
            # 使用數字 ID 而非 username
            tweet_data['author_id'] = self.username_to_id.get(username, username)
            tweet_data['type'] = 'Tweet'
            
            return tweet_data
            
        except Exception as e:
            logger.warning(f"解析推文時出錯：{e}")
            return None
    
    def parse_date(self, date_str):
        """解析日期字符串"""
        try:
            # Nitter 格式: "Dec 23, 2025 · 3:45 PM UTC"
            date_str = date_str.replace(' UTC', '').replace('·', '').strip()
            dt = datetime.strptime(date_str, '%b %d, %Y %I:%M %p')
            return dt.strftime('%Y-%m-%d %H:%M:%S')
        except:
            try:
                dt = datetime.strptime(date_str, '%Y-%m-%d %H:%M:%S')
                return dt.strftime('%Y-%m-%d %H:%M:%S')
            except:
                return datetime.now().strftime('%Y-%m-%d %H:%M:%S')
    
    def save_tweets(self, tweets, username):
        """保存推文到資料庫"""
        if not tweets:
            logger.info("無推文需要保存")
            return 0, 0
        
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            
            new_count = 0
            update_count = 0
            
            for tweet in tweets:
                try:
                    # 檢查是否已存在
                    cursor.execute('SELECT tweet_id FROM tweets WHERE tweet_id = ?', 
                                 (tweet.get('tweet_id'),))
                    exists = cursor.fetchone()
                    
                    cursor.execute('''
                        INSERT OR REPLACE INTO tweets 
                        (tweet_id, text, author_id, type, created_at, hashtags, urls, media_type, media_urls)
                        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
                    ''', (
                        tweet.get('tweet_id', ''),
                        tweet.get('text', ''),
                        tweet.get('author_id', ''),
                        tweet.get('type', 'Tweet'),
                        tweet.get('created_at', ''),
                        tweet.get('hashtags', ''),
                        tweet.get('urls', ''),
                        tweet.get('media_type', ''),
                        tweet.get('media_urls', '')
                    ))
                    
                    if exists:
                        update_count += 1
                    else:
                        new_count += 1
                        
                except Exception as e:
                    logger.warning(f"保存推文失敗：{e}")
            
            conn.commit()
            conn.close()
            
            logger.info(f"✓ 保存完成：新增 {new_count} 條，更新 {update_count} 條")
            return new_count, update_count
            
        except Exception as e:
            logger.error(f"保存到資料庫失敗：{e}")
            return 0, 0
    
    def log_scrape(self, username, tweets_found, tweets_new, tweets_updated, status='completed', error=None):
        """記錄爬取日誌"""
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            
            sql = """
                INSERT INTO scrape_logs 
                (username, tweets_found, tweets_new, tweets_updated, status, error_message, completed_at)
                VALUES (?, ?, ?, ?, ?, ?, ?)
            """
            cursor.execute(sql, (username, tweets_found, tweets_new, tweets_updated, status, error, datetime.now()))
            
            conn.commit()
            conn.close()
        except Exception as e:
            logger.error(f"記錄日誌失敗：{e}")
    
    def scrape_all_users(self):
        """批量爬取所有配置的用戶"""
        if not self.users:
            logger.error("❌ 無用戶配置，請檢查 users.json")
            return
        
        logger.info(f"\n{'='*60}")
        logger.info(f"開始批量爬取 {len(self.users)} 個用戶")
        logger.info(f"{'='*60}\n")
        
        total_new = 0
        total_updated = 0
        
        for user_id = user_config.get('id', i)
            i, user_config in enumerate(self.users, 1):
            username = user_config.get('username')
            max_tweets = user_config.get('max_tweets', None)
            #{user_id} 
            logger.info(f"\n[{i}/{len(self.users)}] 處理 @{username}")
            logger.info("-" * 60)
            
            try:
                # 爬取推文
                tweets = self.scrape_user_tweets(username, max_tweets=max_tweets)
                
                # 保存到資料庫
                new_count, update_count = self.save_tweets(tweets, username)
                
                # 記錄日誌
                self.log_scrape(username, len(tweets), new_count, update_count, 'completed')
                
                total_new += new_count
                total_updated += update_count
                
            except Exception as e:
                logger.error(f"❌ @{username} 爬取失敗：{e}")
                self.log_scrape(username, 0, 0, 0, 'failed', str(e))
            
            # 用戶間延遲
            if i < len(self.users):
                delay = self.settings.get('user_delay', 5)
                logger.info(f"等待 {delay} 秒後繼續...")
                time.sleep(delay)
        
        logger.info(f"\n{'='*60}")
        logger.info(f"批量爬取完成！")
        logger.info(f"總計：新增 {total_new} 條，更新 {total_updated} 條推文")
        logger.info(f"{'='*60}\n")


def main():
    """主程式入口"""
    server = NitterServer(
        config_path='users.json',
        db_path='mydb.db'
    )
    
    server.scrape_all_users()


if __name__ == '__main__':
    main()
